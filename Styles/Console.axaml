<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style Selector="Border.console-keyboard">
        <Setter Property="Background" Value="#F21A2030"/>
        <Setter Property="BorderBrush" Value="#3D6AF2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="24,20"/>
        <Setter Property="MaxWidth" Value="920"/>
    </Style>

    <Style Selector="TextBlock.console-keyboard-query">
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
    </Style>

    <Style Selector="Button.console-keyboard-key">
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Background" Value="#33151A28"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="BorderBrush" Value="#3A455C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.console-keyboard-key.wide">
        <Setter Property="MinWidth" Value="140"/>
    </Style>

    <Style Selector="Button.console-keyboard-key.focused">
        <Setter Property="Background" Value="#3D6AF2"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style Selector="Button.console-keyboard-key:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#262D3E"/>
    </Style>

    <Style Selector="Button.console-keyboard-key.focused:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#4F7BFF"/>
    </Style>

    <Style Selector="UserControl.console-shell Button">
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="UserControl.console-shell Button /template/ ContentPresenter">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.console-wordmark">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.console-search">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="#1A2030"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="BorderBrush" Value="#2C3448"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CaretBrush" Value="#F4F7FF"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.console-search /template/ TextPresenter">
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBox.console-search.menuFocus">
        <Setter Property="BorderBrush" Value="#3D6AF2"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.console-play.menuFocus">
        <Setter Property="BorderBrush" Value="#F4F7FF"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Border.console-categories">
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Border.console-categories.menuFocus">
        <Setter Property="BorderBrush" Value="#3D6AF2"/>
    </Style>

    <Style Selector="ListBox.console-carousel.menuFocus">
        <Setter Property="Opacity" Value="1"/>
    </Style>

    <Style Selector="Border.console-media-dock.menuFocus">
        <Setter Property="BorderBrush" Value="#3D6AF2"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.console-exit">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="Padding" Value="22,10"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="BorderBrush" Value="#5C6A88"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.console-exit.menuFocus">
        <Setter Property="BorderBrush" Value="#3D6AF2"/>
        <Setter Property="BorderThickness" Value="2"/>
    </Style>

    <Style Selector="Button.console-exit:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#262D3E"/>
    </Style>

    <Style Selector="Button.console-chip">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Background" Value="#1A2030"/>
        <Setter Property="Foreground" Value="#D7DFF1"/>
        <Setter Property="BorderBrush" Value="#2C3448"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.console-chip:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#262D3E"/>
    </Style>

    <Style Selector="Button.console-chip.selected">
        <Setter Property="Background" Value="#3D6AF2"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Button.console-chip.selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#4F7BFF"/>
    </Style>

    <Style Selector="Button.console-play">
        <Setter Property="MinWidth" Value="220"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="Padding" Value="36,16"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="CornerRadius" Value="32"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.console-kicker">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#9AA6BF"/>
        <Setter Property="LetterSpacing" Value="1.5"/>
    </Style>

    <Style Selector="TextBlock.console-title">
        <Setter Property="FontSize" Value="54"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="LineHeight" Value="60"/>
    </Style>

    <Style Selector="TextBlock.console-meta">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="Foreground" Value="#C5CEE0"/>
    </Style>

    <Style Selector="TextBlock.console-status">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="#9AA6BF"/>
    </Style>

    <Style Selector="TextBlock.console-empty">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
    </Style>

    <Style Selector="TextBlock.console-hint">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#7E8AA3"/>
    </Style>

    <Style Selector="WrapPanel.console-hint-row">
        <Setter Property="Margin" Value="0,8,0,0"/>
    </Style>

    <Style Selector="StackPanel.console-hint-item">
        <Setter Property="Margin" Value="0,0,18,10"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-keycap">
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="#2C3448"/>
        <Setter Property="BorderBrush" Value="#4A556C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.console-keycap-text">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="ListBox.console-carousel">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="ListBox.console-carousel ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="ListBox.console-carousel ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBox.console-carousel ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="ListBox.console-carousel ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
    </Style>

    <Style Selector="Border.console-tile">
        <Setter Property="Width" Value="168"/>
        <Setter Property="Height" Value="252"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="ClipToBounds" Value="True"/>
        <Setter Property="Background" Value="#1B2130"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="3"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style Selector="ListBox.console-carousel ListBoxItem:selected Border.console-tile">
        <Setter Property="Width" Value="214"/>
        <Setter Property="Height" Value="321"/>
        <Setter Property="BorderBrush" Value="#F4F7FF"/>
    </Style>

    <Style Selector="Border.console-tile-scrim">
        <Setter Property="Background" Value="#B30B0D12"/>
        <Setter Property="Padding" Value="12,28,12,12"/>
        <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>

    <Style Selector="TextBlock.console-tile-title">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Border.console-tile-favorite">
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Margin" Value="8"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="#CC0B0D12"/>
    </Style>

    <Style Selector="Border.console-media">
        <Setter Property="Background" Value="#CC1A2030"/>
        <Setter Property="BorderBrush" Value="#2C3448"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="6,6,8,6"/>
    </Style>

    <Style Selector="Border.console-media-dock">
        <Setter Property="Padding" Value="10,8,14,8"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style Selector="Border.console-media-dock.guide">
        <Setter Property="BorderBrush" Value="#3D6AF2"/>
    </Style>

    <Style Selector="Button.console-media-button">
        <Setter Property="Width" Value="48"/>
        <Setter Property="Height" Value="48"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusAdorner" Value="{x:Null}"/>
    </Style>

    <Style Selector="Button.console-media-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#262D3E"/>
    </Style>

    <Style Selector="Button.console-media-button:disabled">
        <Setter Property="Opacity" Value="0.35"/>
    </Style>

    <Style Selector="Button.console-media-toggle">
        <Setter Property="Background" Value="#3D6AF2"/>
    </Style>

    <Style Selector="Button.console-media-volume">
        <Setter Property="Width" Value="64"/>
        <Setter Property="MinWidth" Value="64"/>
    </Style>

    <Style Selector="Border.console-media-dock.gamepad Button.console-media-button">
        <Setter Property="Width" Value="56"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Height" Value="72"/>
        <Setter Property="MinHeight" Value="72"/>
        <Setter Property="CornerRadius" Value="16"/>
    </Style>

    <Style Selector="Border.console-media-dock.gamepad Button.console-media-volume">
        <Setter Property="Width" Value="76"/>
        <Setter Property="MinWidth" Value="76"/>
    </Style>

    <Style Selector="StackPanel.console-media-prompt">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="StackPanel.console-media-prompt > TextBlock">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="StackPanel.console-media-prompt > Panel">
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="StackPanel.console-media-prompt > Border">
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.console-media-toggle:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#4F7BFF"/>
    </Style>

    <Style Selector="TextBlock.console-media-glyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.console-media-title">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="TextBlock.console-media-artist">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#9AA6BF"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="TextBlock.console-tile-star">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="#F2C14E"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Grid.console-media-guide-overlay">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Border.console-media-guide-scrim">
        <Setter Property="Background" Value="#B30B0D12"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
    </Style>

    <Style Selector="Border.console-media-guide">
        <Setter Property="Background" Value="#F21A2030"/>
        <Setter Property="BorderBrush" Value="#3D6AF2"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="24"/>
        <Setter Property="Padding" Value="36,32"/>
        <Setter Property="Width" Value="720"/>
    </Style>

    <Style Selector="TextBlock.console-media-guide-kicker">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#8EA0FF"/>
        <Setter Property="LetterSpacing" Value="1"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.console-media-guide-title">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.console-media-guide-line">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="Foreground" Value="#C5CEE0"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-media-guide-action">
        <Setter Property="Background" Value="#33151A28"/>
        <Setter Property="BorderBrush" Value="#3A455C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="12,16"/>
        <Setter Property="Margin" Value="6,0"/>
        <Setter Property="Width" Value="148"/>
        <Setter Property="Height" Value="156"/>
    </Style>

    <Style Selector="TextBlock.console-media-guide-glyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.console-media-guide-caption">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#9AA6BF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="ProgressBar.console-media-guide-volume">
        <Setter Property="Margin" Value="12,0"/>
    </Style>

    <Style Selector="Border.console-pad-guide">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-pad-dpad.console-pad-guide">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-pad-guide-trigger">
        <Setter Property="MinWidth" Value="40"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="CornerRadius" Value="5,5,12,12"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-pad-guide TextBlock.console-pad-glyph">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-pad-guide TextBlock.console-pad-letter">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-pad-face">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="#3D6AF2"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-pad-face.x">
        <Setter Property="Background" Value="#3D6AF2"/>
    </Style>

    <Style Selector="Border.console-pad-face.b">
        <Setter Property="Background" Value="#E24B4A"/>
    </Style>

    <Style Selector="Border.console-pad-face.a">
        <Setter Property="Background" Value="#3EB048"/>
    </Style>

    <Style Selector="Border.console-pad-face.y">
        <Setter Property="Background" Value="#F2C14E"/>
    </Style>

    <Style Selector="Border.console-pad-face.console-pad-guide">
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-pad-dpad">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="#2C3448"/>
        <Setter Property="BorderBrush" Value="#4A556C"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style Selector="Border.console-pad-trigger">
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="CornerRadius" Value="4,4,10,10"/>
        <Setter Property="Background" Value="#2C3448"/>
        <Setter Property="BorderBrush" Value="#4A556C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-pad-view">
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="#2C3448"/>
        <Setter Property="BorderBrush" Value="#4A556C"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,4"/>
    </Style>

    <Style Selector="TextBlock.console-pad-letter">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.console-pad-caption">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.console-pad-glyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.console-pad-badge">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="Border.console-pad-face.console-pad-badge">
        <Setter Property="CornerRadius" Value="11"/>
    </Style>

    <Style Selector="Border.console-pad-dpad.console-pad-badge">
        <Setter Property="CornerRadius" Value="5"/>
    </Style>

    <Style Selector="Border.console-pad-badge TextBlock.console-pad-glyph">
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style Selector="TextBlock.console-pad-letter-small">
        <Setter Property="FontSize" Value="10"/>
    </Style>

    <Style Selector="StackPanel.console-pad-badge-row">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style Selector="Border.console-pad-trigger-mini">
        <Setter Property="MinWidth" Value="26"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="CornerRadius" Value="3,3,8,8"/>
    </Style>

    <Style Selector="TextBlock.console-pad-caption-mini">
        <Setter Property="FontSize" Value="9"/>
    </Style>

    <Style Selector="Border.console-media-osd">
        <Setter Property="Background" Value="#E61A2030"/>
        <Setter Property="BorderBrush" Value="#2C3448"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="14,10"/>
    </Style>

    <Style Selector="TextBlock.console-media-osd-glyph">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="Foreground" Value="#F4F7FF"/>
    </Style>

    <Style Selector="TextBlock.console-media-osd-hint">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#9AA6BF"/>
    </Style>

</Styles>
