<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenGameHUB.ViewModels"
             x:Name="RootCard"
             xmlns:conv="using:OpenGameHUB.Converters"
             x:Class="OpenGameHUB.Controls.GameGridCard"
             x:DataType="vm:GameItemViewModel"
             HorizontalAlignment="Left"
             VerticalAlignment="Top">
    <UserControl.Resources>
        <conv:PlatformBrushConverter x:Key="PlatformBrushConverter"/>
    </UserControl.Resources>

    <Border Classes="game-card game-card-grid"
            Classes.selected="{Binding IsSelected}"
            BorderBrush="{Binding IsSelected, Converter={x:Static conv:SelectionBorderConverter.Instance}}"
            PointerPressed="OnCardPressed"
            DoubleTapped="OnGameDoubleTapped"
            ContextRequested="OnContextRequested">
        <Panel>
            <Border Classes="game-cover-area"
                    Height="{Binding CoverHeight, ElementName=RootCard}">
                <Panel>
                    <Panel IsVisible="{Binding DisplayGridCover}">
                        <Image Source="{Binding CoverImage}"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Opacity="{Binding GridCoverOpacity}"/>
                        <Border Classes="overlay-dim"
                                IsVisible="{Binding !IsInstalled}"/>
                    </Panel>
                    <Border IsVisible="{Binding !DisplayGridCover}"
                            Background="{Binding Platform, Converter={StaticResource PlatformBrushConverter}}"
                            Opacity="{Binding GridPlaceholderOpacity}"/>
                </Panel>
            </Border>

            <Border Classes="favorite-mark"
                    IsVisible="{Binding IsFavorite}">
                <TextBlock Text="&#x2605;" Classes="favorite-glyph"/>
            </Border>

            <Border Classes="cover-scrim">
                <StackPanel VerticalAlignment="Bottom" Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Border Classes="platform-badge"
                                Background="{Binding Platform, Converter={StaticResource PlatformBrushConverter}}">
                            <TextBlock Text="{Binding PlatformLabel}"
                                       Classes="badge-label"/>
                        </Border>
                        <Border Classes="platform-badge also-on-badge"
                                IsVisible="{Binding HasAlsoOnBadge}">
                            <TextBlock Text="{Binding AlsoOnLabel}"
                                       Classes="badge-label"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Title}"
                               Classes="overlay-title"
                               TextWrapping="Wrap"
                               MaxHeight="40"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <Button Classes="primary card-hover-action"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MinWidth="96"
                    Content="{Binding ActionLabel}"
                    Click="OnPlayClick"/>
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="10"
                        Spacing="6">
                <Button Classes="manage-icon card-hover-action"
                        Classes.favorite-on="{Binding IsFavorite}"
                        ToolTip.Tip="{Binding FavoriteToolTip}"
                        Click="OnFavoriteClick">
                    <Panel>
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="{StaticResource GeometryHeartOutline}"
                                  IsVisible="{Binding !IsFavorite}"/>
                        <PathIcon Width="16"
                                  Height="16"
                                  Data="{StaticResource GeometryHeart}"
                                  IsVisible="{Binding IsFavorite}"/>
                    </Panel>
                </Button>
                <Button Classes="manage-icon card-hover-action"
                        ToolTip.Tip="{Binding ManageGameLabel}"
                        Click="OnManageClick">
                    <PathIcon Width="16"
                              Height="16"
                              Data="{StaticResource GeometrySettings}"/>
                </Button>
            </StackPanel>
        </Panel>
    </Border>
</UserControl>
