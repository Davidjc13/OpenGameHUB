<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenGameHUB.ViewModels"
             xmlns:conv="using:OpenGameHUB.Converters"
             x:Class="OpenGameHUB.Controls.GameListCard"
             x:DataType="vm:GameItemViewModel">
    <UserControl.Resources>
        <conv:PlatformBrushConverter x:Key="PlatformBrushConverter"/>
    </UserControl.Resources>

    <Border Classes="game-card game-card-list"
            Classes.selected="{Binding IsSelected}"
            BorderBrush="{Binding IsSelected, Converter={x:Static conv:SelectionBorderConverter.Instance}}"
            PointerPressed="OnCardPressed"
            DoubleTapped="OnGameDoubleTapped"
            ContextRequested="OnContextRequested">
        <Grid ColumnDefinitions="Auto,*,Auto"
              Margin="12,10"
              ColumnSpacing="14">
            <Border Grid.Column="0"
                    Classes="game-list-thumb">
                <Panel>
                    <Image Source="{Binding CoverImage}"
                           Stretch="UniformToFill"
                           IsVisible="{Binding DisplayListCover}"
                           Opacity="{Binding GridCoverOpacity}"/>
                    <Border Background="{Binding Platform, Converter={StaticResource PlatformBrushConverter}}"
                            Opacity="{Binding GridPlaceholderOpacity}"
                            IsVisible="{Binding !DisplayListCover}"/>
                    <Border Classes="overlay-dim"
                            IsVisible="{Binding !IsInstalled}"/>
                </Panel>
            </Border>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Border Classes="platform-badge"
                            Background="{Binding Platform, Converter={StaticResource PlatformBrushConverter}}">
                        <TextBlock Text="{Binding PlatformLabel}"
                                   Classes="badge-label"/>
                    </Border>
                    <Border Classes="platform-badge also-on-badge"
                            IsVisible="{Binding HasAlsoOnBadge}">
                        <TextBlock Text="{Binding AlsoOnLabel}"
                                   Classes="badge-label"/>
                    </Border>
                    <TextBlock Text="&#x2605;"
                               Classes="favorite-glyph"
                               IsVisible="{Binding IsFavorite}"/>
                </StackPanel>
                <TextBlock Text="{Binding Title}"
                           Classes="card-title-lg"
                           TextWrapping="Wrap"
                           MaxHeight="40"
                           TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding InstallStatus}"
                           FontSize="{DynamicResource FontSizeListMeta}"
                           Classes="text-status"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Classes="ghost"
                        MinWidth="88"
                        Content="{Binding ActionLabel}"
                        Click="OnPlayClick"/>
                <Button Classes="icon"
                        ToolTip.Tip="{Binding ManageGameLabel}"
                        Click="OnManageClick">
                    <PathIcon Width="16"
                              Height="16"
                              Data="{StaticResource GeometrySettings}"/>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
