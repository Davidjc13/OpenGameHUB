<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenGameHUB.ViewModels"
        x:Class="OpenGameHUB.Views.StoreInstallChoiceDialog"
        x:DataType="vm:StoreInstallChoiceDialogViewModel"
        Title="{Binding Title}"
        Width="420"
        Height="320"
        MinWidth="360"
        MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Classes="app-window">
    <Grid Margin="24" RowDefinitions="Auto,*,Auto">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="{Binding GameTitle}"
                       Classes="heading-subtitle"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding Message}"
                       Classes="text-secondary"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <ListBox Grid.Row="1"
                 Margin="0,16,0,0"
                 ItemsSource="{Binding Options}"
                 SelectedItem="{Binding SelectedOption}"/>

        <StackPanel Grid.Row="2"
                    Margin="0,20,0,0"
                    Orientation="Horizontal"
                    Spacing="10"
                    HorizontalAlignment="Right">
            <Button Content="{Binding Strings.Cancel}"
                    Command="{Binding CancelCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Classes="primary"
                    Content="{Binding InstallLabel}"
                    Command="{Binding ConfirmCommand}"
                    CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"/>
        </StackPanel>
    </Grid>
</Window>
