<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenGameHUB.ViewModels"
        xmlns:main="using:OpenGameHUB.ViewModels.MainWindow"
        xmlns:controls="using:OpenGameHUB.Controls"
        x:Class="OpenGameHUB.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/app.ico"
        Title="OpenGameHUB"
        Width="1280"
        Height="800"
        MinWidth="1000"
        MinHeight="640"
        Classes="app-window"
        Opened="OnOpened">

    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Margin="{StaticResource ThicknessWindowMargin}">
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="16"
              Margin="{StaticResource ThicknessSectionGap}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="OpenGameHUB" Classes="wordmark"/>
                <TextBlock Text="{Binding Updates.AppVersionText}"
                           Classes="text-caption"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBox Grid.Column="1"
                     Name="SearchBox"
                     Classes="search-input"
                     MaxWidth="560"
                     HorizontalAlignment="Stretch"
                     PlaceholderText="{Binding Strings.SearchPlaceholder}"
                     Text="{Binding Sidebar.SearchText, Mode=TwoWay}"
                     TextChanged="OnSearchTextChanged"/>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button Classes="icon"
                        ToolTip.Tip="{Binding Strings.Settings}"
                        Command="{Binding OpenSettingsCommand}">
                    <PathIcon Width="16"
                              Height="16"
                              Data="{StaticResource GeometrySettings}"/>
                </Button>
                <Button Classes="primary"
                        VerticalAlignment="Center"
                        Content="{Binding Strings.RefreshLibrary}"
                        Command="{Binding RefreshLibraryCommand}"
                        IsEnabled="{Binding !Library.IsRefreshing}"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Classes="update-banner"
                Margin="{StaticResource ThicknessSectionGap}"
                IsVisible="{Binding Updates.IsAppUpdateBannerVisible}">
            <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Updates.AppUpdateBannerText}"
                               Classes="text-banner"
                               TextWrapping="Wrap"/>
                    <ProgressBar Minimum="0"
                                 Maximum="100"
                                 Value="{Binding Updates.AppUpdateProgress}"
                                 IsVisible="{Binding Updates.IsAppUpdateInstalling}"
                                 Height="4"
                                 Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="primary"
                        Margin="16,0,10,0"
                        VerticalAlignment="Center"
                        Content="{Binding Strings.AppUpdateInstallNow}"
                        Click="OnInstallAppUpdateClick"
                        IsEnabled="{Binding !Updates.IsAppUpdateInstalling}"/>
                <Button Grid.Column="2"
                        Classes="ghost"
                        VerticalAlignment="Center"
                        Content="{Binding Strings.AppUpdateDismissLater}"
                        Command="{Binding Updates.DismissBannerCommand}"
                        IsEnabled="{Binding !Updates.IsAppUpdateInstalling}"/>
            </Grid>
        </Border>

        <ProgressBar Grid.Row="2"
                     Height="3"
                     Margin="0,0,0,8"
                     IsIndeterminate="True"
                     IsVisible="{Binding Library.IsRefreshing}"/>

        <Grid Grid.Row="3" ColumnDefinitions="228,*">
            <Grid RowDefinitions="Auto,Auto,*,Auto,*"
                  Margin="0,0,4,0">
                <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,8,12">
                    <TextBlock Text="{Binding Strings.Sort}"
                               Classes="text-caption"
                               Margin="10,0,0,0"/>
                    <ComboBox ItemsSource="{Binding Sidebar.SortOptions}"
                              SelectedItem="{Binding Sidebar.SelectedSortOption}"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="main:SortOptionItem">
                                <TextBlock Text="{Binding Label}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Row="1"
                           Text="{Binding Strings.Platforms}"
                           Classes="text-caption"
                           Margin="10,0,0,6"/>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Sidebar.PlatformFilters}"
                         SelectedItem="{Binding Sidebar.SelectedPlatformFilter}"
                         Classes="rail-list">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="main:PlatformFilterItem">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="10,12,8,6">
                    <TextBlock Grid.Column="0"
                               Text="{Binding Strings.Collections}"
                               Classes="text-caption"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Classes="sidebar-icon"
                            Content="+"
                            ToolTip.Tip="{Binding Strings.NewCollection}"
                            Command="{Binding Sidebar.CreateCollectionCommand}"/>
                </Grid>

                <ListBox Grid.Row="4"
                         x:Name="LibraryCollectionsListBox"
                         ItemsSource="{Binding Sidebar.LibraryCollections}"
                         SelectedItem="{Binding Sidebar.SelectedLibraryCollection}"
                         Classes="rail-list"
                         ContextRequested="OnLibraryCollectionContextRequested">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:LibraryCollectionItem">
                            <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <Grid Grid.Column="1" Margin="16,0,0,0" RowDefinitions="Auto,*">
                <Grid Grid.Row="0"
                      ColumnDefinitions="*,Auto"
                      Margin="0,0,0,12">
                    <TextBlock Grid.Column="0"
                               Classes="text-body"
                               Text="{Binding StatusText}"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <Button Classes="icon"
                                IsVisible="{Binding Library.IsGridView}"
                                ToolTip.Tip="{Binding Library.GridCardSizeLabel}">
                            <PathIcon Width="16"
                                      Height="16"
                                      Data="{StaticResource GeometryResize}"/>
                            <Button.Flyout>
                                <Flyout Placement="Bottom">
                                    <StackPanel Spacing="10"
                                                Margin="14,10"
                                                MinWidth="220">
                                        <TextBlock Text="{Binding Library.GridCardSizeLabel}"
                                                   Classes="text-secondary"/>
                                        <Slider Minimum="{Binding Library.GridCardSizeMinimum}"
                                                Maximum="{Binding Library.GridCardSizeMaximum}"
                                                Value="{Binding Library.GridCardSize}"/>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                        <Button Content="{Binding Strings.AddCustomGameShort}"
                                Classes="ghost"
                                ToolTip.Tip="{Binding Strings.AddCustomGame}"
                                Command="{Binding Sidebar.AddCustomGameCommand}"/>
                        <Button Content="{Binding Strings.ViewGrid}"
                                Command="{Binding Library.SetGridViewCommand}"
                                Classes.primary="{Binding Library.IsGridView}"
                                Classes.ghost="{Binding Library.IsListView}"/>
                        <Button Content="{Binding Strings.ViewList}"
                                Command="{Binding Library.SetListViewCommand}"
                                Classes.primary="{Binding Library.IsListView}"
                                Classes.ghost="{Binding Library.IsGridView}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1">
                    <Grid RowDefinitions="*,Auto">
                        <ScrollViewer x:Name="GamesScrollViewer"
                                      Grid.Row="0"
                                      Classes="library-scroll"
                                      Classes.clip-y="{Binding !Library.IsListView}"
                                      SizeChanged="OnGamesViewportSizeChanged">
                            <Grid MinWidth="{Binding Bounds.Width, ElementName=GamesScrollViewer}">
                                <ItemsControl ItemsSource="{Binding Library.Games}"
                                              IsVisible="{Binding !Library.IsListView}"
                                              HorizontalAlignment="Stretch"
                                              Width="{Binding Bounds.Width, ElementName=GamesScrollViewer}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <controls:CenteredWrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GameItemViewModel">
                                            <controls:GameGridCard/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <ItemsControl ItemsSource="{Binding Library.Games}"
                                              IsVisible="{Binding Library.IsListView}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="10"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:GameItemViewModel">
                                            <controls:GameListCard/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>

                        <Border Grid.Row="1"
                                Margin="0,12,0,0"
                                Padding="0,12,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Button Grid.Column="0"
                                        Classes="ghost"
                                        Content="{Binding Strings.PreviousPage}"
                                        Command="{Binding Library.PreviousPageCommand}"/>
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           Classes="pagination-label"
                                           Text="{Binding Library.GamesCountLabel}"/>
                                <Button Grid.Column="2"
                                        Classes="ghost"
                                        Content="{Binding Strings.NextPage}"
                                        Command="{Binding Library.NextPageCommand}"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Classes="detail-drawer"
                            IsVisible="{Binding Library.HasSelectedGame}">
                        <Grid RowDefinitions="Auto,*">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Strings.Detail}"
                                           Classes="heading-panel"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Classes="icon"
                                        ToolTip.Tip="{Binding Strings.Close}"
                                        Command="{Binding Library.CloseDetailCommand}">
                                    <TextBlock Text="&#x00D7;"
                                               FontSize="18"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Spacing="14">
                                    <Border Width="200"
                                            Height="300"
                                            Classes="cover-frame-lg"
                                            IsVisible="{Binding Library.ShowDetailCover}">
                                        <Image Source="{Binding Library.SelectedGame.CoverImage}"
                                               Stretch="Uniform"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               IsVisible="{Binding Library.SelectedGame.HasCover}"/>
                                    </Border>

                                    <TextBlock Text="{Binding Library.SelectedGameTitle}"
                                               Classes="detail-title"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Library.SelectedGame.InstallStatus, TargetNullValue=''}"
                                               Classes="text-body"/>
                                    <TextBlock Text="{Binding Library.SelectedGame.InstallPath, TargetNullValue=''}"
                                               TextWrapping="Wrap"
                                               Classes="text-help"/>

                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Button Grid.Column="0"
                                                Classes="primary"
                                                MinWidth="0"
                                                Content="{Binding Library.SelectedGameActionLabel}"
                                                HorizontalAlignment="Stretch"
                                                Command="{Binding Library.LaunchSelectedGameCommand}"/>
                                        <Button Grid.Column="1"
                                                Classes="icon"
                                                ToolTip.Tip="{Binding Strings.ManageGame}"
                                                IsVisible="{Binding Library.HasSelectedGame}"
                                                Click="OnManageGameClick">
                                            <PathIcon Width="16"
                                                      Height="16"
                                                      Data="{StaticResource GeometrySettings}"/>
                                        </Button>
                                    </Grid>

                                    <Button Content="{Binding Strings.ToggleFavorite}"
                                            Classes="quiet"
                                            Command="{Binding Library.ToggleFavoriteCommand}"
                                            CommandParameter="{Binding Library.SelectedGame}"/>

                                    <StackPanel Spacing="8"
                                                IsVisible="{Binding Sidebar.ShowDetailCollections}">
                                        <TextBlock Text="{Binding Strings.AddToCollection}"
                                                   Classes="text-label"/>
                                        <ItemsControl ItemsSource="{Binding Sidebar.DetailCollectionMemberships}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:CollectionMembershipItem">
                                                    <CheckBox Content="{Binding Name}"
                                                              IsChecked="{Binding IsMember, Mode=OneWay}"
                                                              Classes="sidebar"
                                                              Click="OnCollectionMembershipClick"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Button Content="{Binding Strings.ChangeCover}"
                                            Classes="quiet"
                                            Command="{Binding Library.ChangeCustomCoverCommand}"/>
                                    <Button Content="{Binding Strings.ResetCover}"
                                            Classes="quiet"
                                            Command="{Binding Library.ResetCustomCoverCommand}"
                                            IsVisible="{Binding Library.SelectedGameHasCustomCover}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
